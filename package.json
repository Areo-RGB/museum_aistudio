{
  "name": "personal-museum-media-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vp test",
    "dev": "vp dev --host 0.0.0.0 --port 3000",
    "build": "vp build",
    "preview": "vp preview --host 0.0.0.0 --port 3000",
    "deploy": "cf deploy",
    "r2:mirror": "node scripts/r2.mjs mirror",
    "r2:manifest": "node scripts/r2.mjs manifest --upload",
    "lint": "vp lint . --max-warnings 0",
    "lint:fix": "vp lint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prepare": "vp config"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@react-three/test-renderer": "^9.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.2.0",
    "cf": "^1.0.0-beta.13",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  }
}
